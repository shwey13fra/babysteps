# BabySteps Germany — environment
#
# Grouped by what actually reads each value, because the flat list this file
# used to be caused a real mistake on 2026-11-15: it listed names nothing reads,
# and the production variable list was quoted from it as 13 when the correct
# answer is 12. A template is documentation, and documentation that is wrong
# about which secrets a deployment needs is worse than none.
#
# tests/security/posture.test.ts asserts that every name the shipped code reads
# appears below, so this file cannot silently fall behind app/ and lib/.
#
# Never commit real values. .env.local is gitignored and stays that way.


# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — all 12. The deployment is wrong without any of them.
# ---------------------------------------------------------------------------

# The public origin, no trailing slash, e.g. https://babysteps-germany.vercel.app
# NEXT_PUBLIC_*, so it is baked in AT BUILD TIME: changing it needs a redeploy.
# Falls back to VERCEL_URL, so a preview links to itself rather than to nothing.
NEXT_PUBLIC_SITE_URL=

# Supabase. Only the project URL is public; the service-role key is server-only
# and must never reach a client bundle (CLAUDE.md rule 7, asserted in tests).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Models. ANTHROPIC_API_KEY is read by the SDK itself — `new Anthropic()` with
# no arguments — so it appears in no source file but is required all the same.
# EMBEDDING_API_KEY is OpenAI: the visitor's question text is sent there to
# build the search vector, which is why OpenAI is a disclosed processor in
# /datenschutz and needs its own DPA.
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=

# Upstash, for the per-IP rate limit on /api/ask. Without these in production
# the limiter FAILS CLOSED and /api/ask returns 503 — deliberate: a missing
# credential must never turn a metered endpoint into an unmetered one.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs partner share links. ONE-WAY: rotating it invalidates every link already
# sent. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_LINK_HMAC_SECRET=

# Impressum (DDG §5), rendered by /impressum and named as controller in
# /datenschutz. ALL FOUR OR NONE — a §5 notice missing a line looks complete,
# so the page withholds the whole set instead. Never hard-coded: once the repo
# is public the address is permanent and cannot be rotated like a key.
# The street must be a real one; a Postfach does not satisfy §5.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=


# ---------------------------------------------------------------------------
# OPTIONAL — set only when you want the behaviour
# ---------------------------------------------------------------------------

# Kill switch for /api/ask. Set to exactly "1" to return 503 with an honest
# maintenance message, before any model call. Leave unset in normal operation.
ASK_DISABLED=

# Local development only (ADR-081). The host:port this machine is reachable at
# from a phone on the same network. Without it, `next dev` blocks its own
# cross-origin resources, the page returns 200, and then no client island
# hydrates — a silent failure that looks like a stuck loading state.
# Does nothing in production. Never commit a real value.
DEV_LAN_ORIGIN=


# ---------------------------------------------------------------------------
# NOT READ BY THE APPLICATION — do not add these to Vercel
# ---------------------------------------------------------------------------

# Nothing in app/, lib/ or scripts/ reads the anon key: there is no browser-side
# Supabase client, and every query runs server-side through the service-role
# client. Kept here only because the Stage E verification needs the VALUE to
# confirm that an anon-key select against production returns zero rows — that is
# a check run from a developer machine, not a deployment variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# F6 e-mail reminders, deferred (confirmed 2026-11-15). Nothing in the shipped
# code references either name. They return when reminders ship, at which point
# the cron route gets its Authorization: Bearer CRON_SECRET check BEFORE it does
# anything at all, and Resend rejoins the processor list in /datenschutz.
RESEND_API_KEY=
CRON_SECRET=
