# What does not go to the edge. Playbook line 119, ruled 2026-11-12.
#
# Syntax is .gitignore's. This file only affects what `vercel deploy` uploads
# from a working directory; a git-linked deploy already excludes whatever
# .gitignore excludes. Both paths matter, so the two lists overlap on purpose.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE ADDING A LINE
#
# Four things are read from disk at RUNTIME with readFileSync(process.cwd()...):
#
#   data/rules/           lib/timeline/rules.ts:80
#   data/consular/        lib/rag/consular.ts:121
#   data/glossary.de-en.yaml   lib/rag/expand.ts:26, lib/rag/guards.ts:39
#   lib/prompts/*.md      lib/rag/generate.ts:24, lib/rag/guards.ts:31
#
# They are not imported, so no bundler traces them and nothing fails at build
# time. Excluding any of them produces a deployment that builds green and then
# throws on the first request. Never add them here.
# ---------------------------------------------------------------------------

# The fetched corpus. Large, gitignored, and already embedded into Supabase —
# the edge queries pgvector, it never reads these.
data/raw/
data/cache/

# Evaluation: the golden set, the harness reports, the budget ledger. Developer
# instruments. Nothing in app/ or lib/ touches them.
data/golden/
data/eval-budget.yaml
eval/

# Local tsx scripts — ingestion and eval. "Never run in production" (CLAUDE.md
# repo map), so they have no business being there to run.
scripts/

# Schema is code, but it is applied against Supabase from a developer machine,
# not from a function.
supabase/

# Tests and their fixtures.
tests/
vitest.config.mts

# Documentation. The design system, the legal pack and the ADRs are how we
# build the product, not part of it. Legal TEXT that users must see is rendered
# from app/ and from IMPRESSUM_* env vars, never from these files.
docs/
knowledge/
README.md

# Strategy documents. Gitignored as well; this line is for a CLI deploy from a
# working directory that still has them on disk.
PRD-*.docx
PRD-*.pdf
babysteps-execution-playbook*
babysteps-build-brief*

# Agent instructions.
CLAUDE.md
.claude/
